  <diagram id="I02jHIHO5_NpeTLl6-Xf" name="Trang-9">
    <mxGraphModel dx="2146" dy="2340" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\n\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam nodesep 40\nskinparam ranksep 50\nhide circle\n\nclass NhanVien {\n  - maNV: String\n  - hoTen: String\n  - ngaySinh: Date\n  - gioiTinh: String\n  - diaChi: String\n  - soDienThoai: String\n  - email: String\n  - ngayVaoLam: Date\n  - trangThai: String\n  + themNhanVien(): void\n  + capNhatThongTin(): void\n  + xemLichLamViec(): void\n  + xemPhieuLuong(): void\n}\n\nclass HoSoBaoHiem {\n  - maHoSo: int\n  - loaiBaoHiem: String\n  - maSoBaoHiem: String\n  - ngayBatDau: Date\n  - ngayKetThuc: Date\n  - trangThai: String\n  + themHoSo(): void\n  + capNhatHoSo(): void\n  + traCuuHoSo(): void\n}\n\nclass TuyenDung {\n  - maTuyenDung: int\n  - viTri: String\n  - soLuong: int\n  - ngayDang: Date\n  - hanNop: Date\n  - moTa: String\n  - trangThai: String\n  + taoTinTuyenDung(): void\n  + capNhatTinTuyenDung(): void\n  + dongTinTuyenDung(): void\n}\n\nclass HoSoUngVien {\n  - maUngVien: int\n  - hoTen: String\n  - ngaySinh: Date\n  - soDienThoai: String\n  - email: String\n  - diaChi: String\n  - trinhDo: String\n  - ketQuaPhongVan: String\n  - trangThai: String\n  + tiepNhanHoSo(): void\n  + capNhatHoSo(): void\n  + danhGiaUngVien(): void\n  + ghiNhanKetQua(): void\n}\n\nclass HopDongLaoDong {\n  - maHopDong: int\n  - loaiHopDong: String\n  - ngayKy: Date\n  - ngayBatDau: Date\n  - ngayHetHan: Date\n  - mucLuong: double\n  - trangThai: String\n  + lapHopDong(): void\n  + capNhatHopDong(): void\n  + giaHanHopDong(): void\n  + ketThucHopDong(): void\n}\n\nclass QuyetDinhLuong {\n  - maQuyetDinhLuong: int\n  - mucLuongCu: double\n  - mucLuongMoi: double\n  - ngayQuyetDinh: Date\n  - ngayApDung: Date\n  - lyDo: String\n  + lapQuyetDinh(): void\n  + capNhatQuyetDinh(): void\n  + pheDuyetQuyetDinh(): void\n}\n\nclass QuyetDinhChucVu {\n  - maQuyetDinhChucVu: int\n  - chucVuCu: String\n  - chucVuMoi: String\n  - ngayQuyetDinh: Date\n  - ngayApDung: Date\n  - lyDo: String\n  + lapQuyetDinh(): void\n  + capNhatQuyetDinh(): void\n  + pheDuyetQuyetDinh(): void\n}\n\nclass KhenThuongKyLuat {\n  - maQuyetDinh: int\n  - loaiQuyetDinh: String\n  - noiDung: String\n  - soTien: double\n  - ngayQuyetDinh: Date\n  - lyDo: String\n  + lapQuyetDinh(): void\n  + capNhatQuyetDinh(): void\n  + pheDuyetQuyetDinh(): void\n}\n\nclass LichLamViec {\n  - maLich: int\n  - ngayLam: Date\n  - caLam: String\n  - gioBatDau: Time\n  - gioKetThuc: Time\n  - loaiCa: String\n  + lapLich(): void\n  + capNhatLich(): void\n  + phanCaNhanVien(): void\n}\n\nclass ChamCong {\n  - maChamCong: int\n  - ngayChamCong: Date\n  - gioVao: Time\n  - gioRa: Time\n  - soGioLam: double\n  - soGioTangCa: double\n  - trangThai: String\n  + ghiNhanChamCong(): void\n  + capNhatChamCong(): void\n  + tinhGioLam(): double\n  + tinhGioTangCa(): double\n}\n\nclass BangLuong {\n  - maBangLuong: int\n  - thang: int\n  - nam: int\n  - luongCoBan: double\n  - tienPhuCap: double\n  - tienTangCa: double\n  - tienKhauTru: double\n  - tongLuong: double\n  - ngayLap: Date\n  - trangThai: String\n  + tinhLuong(): double\n  + lapBangLuong(): void\n  + xacNhanBangLuong(): void\n}\n\nclass PhieuThuChi {\n  - maPhieu: int\n  - loaiPhieu: String\n  - noiDung: String\n  - soTien: double\n  - ngayLap: Date\n  - nguoiLap: String\n  + lapPhieu(): void\n  + capNhatPhieu(): void\n  + inPhieu(): void\n}\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HoSoBaoHiem\nTuyenDung \&quot;1\&quot; -- \&quot;0..*\&quot; HoSoUngVien\nHoSoUngVien \&quot;0..1\&quot; -- \&quot;0..1\&quot; HopDongLaoDong : trung tuyen\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HopDongLaoDong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhLuong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; KhenThuongKyLuat\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; LichLamViec\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChamCong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; BangLuong\n\nLichLamViec \&quot;1\&quot; -- \&quot;0..*\&quot; ChamCong\nBangLuong \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuThuChi\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ENR9vPCLakk4vhHRr2mT-1">
