  <diagram id="l1eWiKfv4qoD0baq1NsC" name="Trang-7">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam activity {\n    BackgroundColor #EAF2F8\n    BorderColor #2874A6\n    DiamondBackgroundColor #FCF3CF\n    DiamondBorderColor #B7950B\n}\n\ntitle ACTIVITY DIAGRAM - NGHIỆP VỤ LẬP TOA THUỐC\n\n|Bác sĩ|\nstart\n:Mở phiếu khám bệnh;\n:Xem thông tin bệnh nhân;\n:Xem triệu chứng và kết luận khám;\n\n|Hệ thống|\n:Kiểm tra kết quả xét nghiệm;\n\nif (Có kết quả xét nghiệm?) then (Có)\n    :Hiển thị kết quả xét nghiệm;\nelse (Không)\n    :Tiếp tục dựa trên kết quả khám;\nendif\n\n|Bác sĩ|\n:Đánh giá tình trạng bệnh;\nif (Cần kê toa thuốc?) then (Có)\n    :Chọn thuốc điều trị;\n    :Nhập liều lượng, số lượng,\\ncách dùng và số ngày dùng;\n    :Nhập lời dặn nếu có;\nelse (Không)\n    :Không lập toa thuốc;\n    stop\nendif\n\n|Hệ thống|\n:Kiểm tra thông tin toa thuốc;\n\nwhile (Thông tin chưa hợp lệ?) is (Có)\n    |Bác sĩ|\n    :Chỉnh sửa thông tin toa thuốc;\n    |Hệ thống|\n    :Kiểm tra lại thông tin;\nendwhile (Không)\n\n:Lưu toa thuốc;\n:Lưu chi tiết toa thuốc;\n:Cập nhật liên kết với phiếu khám;\n\nif (Lưu thành công?) then (Có)\n    :Thông báo lập toa thành công;\n    |Bác sĩ|\n    :Kiểm tra và hoàn tất toa thuốc;\nelse (Không)\n    :Thông báo lỗi;\n    |Bác sĩ|\n    :Thực hiện lại thao tác lưu;\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Hl5p0eW0NX1rbDP3qzSv-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
